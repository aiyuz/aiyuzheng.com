---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover}>
  <div class="wrap">
    <article class="prose">
      <p class="eyebrow"><a href="/research-highlights/">Research highlights</a></p>
      <h1>{post.data.title}</h1>
      <div class="post-date" style="margin-bottom:1.6rem">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
      {post.data.cover && <img src={post.data.cover} alt="" style="border-radius:6px; margin: 0 0 1.8rem;" />}
      <Content />
    </article>
  </div>
</Base>
